# ============================================================
# URL BERSIH (tanpa .html) — Apache
# Setiap halaman berada di folder sendiri: /kontak/ → kontak/index.html
# ============================================================

DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # URL lama /kontak.html → /kontak/ (301, agar link & indeks Google lama tetap jalan)
    RewriteRule ^(tentang|pemerintahan|transparansi|potensi|fasilitas|galeri|kontak)\.html$ /$1/ [R=301,L]

    # /index.html atau /kontak/index.html → / atau /kontak/
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# ============================================================
# HALAMAN ERROR — tampilan sesuai desain situs (folder /error/)
# ============================================================
ErrorDocument 400 /error/400.html
ErrorDocument 401 /error/401.html
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 500 /error/500.html
ErrorDocument 503 /error/503.html

# ============================================================
# MODE PEMELIHARAAN (503)
# Aktifkan dengan menghapus tanda "#" pada 5 baris di bawah.
# Ganti 203\.0\.113\.10 dengan IP Anda agar admin tetap bisa membuka situs.
# ============================================================
# <IfModule mod_rewrite.c>
#     RewriteCond %{REMOTE_ADDR} !^203\.0\.113\.10$
#     RewriteCond %{REQUEST_URI} !^/(error|assets|images)/
#     RewriteRule ^ - [R=503,L]
# </IfModule>
